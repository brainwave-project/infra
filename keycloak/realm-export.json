{
  "realm": "brainwave",
  "enabled": true,
  "displayName": "Brainwave",
  "displayNameHtml": "<b>Brainwave</b>",

  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,

  "defaultSignatureAlgorithm": "RS256",

  "accessTokenLifespan": 900,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": false,
  "offlineSessionMaxLifespan": 5184000,
  "refreshTokenMaxReuse": 0,
  "revokeRefreshToken": true,

  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Full platform access: manage users, all documents, system config",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "EDITOR",
        "description": "Create, read, and update documents. Cannot delete or manage users",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "VIEWER",
        "description": "Read-only access to documents they have been granted access to",
        "composite": false,
        "clientRole": false
      }
    ]
  },

  "defaultRoles": ["VIEWER"],

  "clients": [
    {
      "clientId": "brainwave-public",
      "name": "Brainwave Web Client",
      "description": "Public PKCE client for browser-based frontend (SPA). No client secret.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "authorizationServicesEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*",
        "http://localhost:8000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173",
        "http://localhost:8000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://localhost:5173/*"
      },
      "defaultClientScopes": ["web-origins", "profile", "roles", "email"],
      "optionalClientScopes": ["address", "phone", "offline_access"]
    },
    {
      "clientId": "auth-hub-service",
      "name": "AuthHub Service Account",
      "description": "Confidential client for AuthHub to call Keycloak Admin API. Manages users, assigns roles.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "auth-hub-dev-secret-change-in-prod",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "attributes": {}
    },
    {
      "clientId": "brainwave-dev",
      "name": "Local Dev Client (Direct Grant)",
      "description": "DEV ONLY — Enables Resource Owner Password Credentials for local testing with curl/Postman. REMOVE IN PRODUCTION.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "attributes": {}
    }
  ],

  "clientScopes": [
    {
      "name": "documents.write",
      "description": "Scope required for creating and updating documents",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    },
    {
      "name": "documents.read",
      "description": "Scope required for reading documents",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    }
  ],

  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "id": "brainwave-dev-rsa-key",
        "name": "brainwave-dev-rsa",
        "providerId": "rsa",
        "subComponents": {},
        "config": {
          "privateKey": [
            ""
          ],
          "active":   ["true"],
          "enabled":  ["true"],
          "priority": ["100"],
          "keySize":  ["2048"]
        }
      }
    ]
  },

  "passwordPolicy": "length(8) and notUsername(undefined) and notEmail(undefined)",

  "smtpServer": {},

  "loginTheme": "keycloak",
  "accountTheme": "keycloak.v3",
  "adminTheme": "keycloak.v2",
  "emailTheme": "keycloak",

  "internationalizationEnabled": false,
  "supportedLocales": ["en"],
  "defaultLocale": "en",

  "users": [
    {
      "username": "dev-admin",
      "email": "dev-admin@brainwave.local",
      "firstName": "Dev",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "dev-editor",
      "email": "dev-editor@brainwave.local",
      "firstName": "Dev",
      "lastName": "Editor",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "editor123",
          "temporary": false
        }
      ],
      "realmRoles": ["EDITOR"]
    },
    {
      "username": "dev-viewer",
      "email": "dev-viewer@brainwave.local",
      "firstName": "Dev",
      "lastName": "Viewer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "viewer123",
          "temporary": false
        }
      ],
      "realmRoles": ["VIEWER"]
    }
  ],

  "scopeMappings": [],
  "clientScopeMappings": {}
}
