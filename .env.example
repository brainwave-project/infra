# =============================================================================
# DEPRECATED — use env/.env.dev, env/.env.staging.example, env/.env.prod.example
# =============================================================================
# Brainwave — Infrastructure Environment Variables
# Copy this file to .env and fill in values before running docker compose.
#
# .env is gitignored. .env.example is committed and documents every variable.
# NEVER commit real secrets to .env.example — use placeholder values only.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=brainwave
POSTGRES_PASSWORD=change-in-production
POSTGRES_DB=brainwave

# App-level DB users (created by 01-schemas.sql)
# These are used by the microservices, NOT the root postgres user
USERHUB_DB_PASS=userhub_dev_password
KNOWHUB_DB_PASS=knowhub_dev_password

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
MONGO_USER=brainwave
MONGO_PASSWORD=change-in-production
MONGO_DB=brainwave_docs

# -----------------------------------------------------------------------------
# MinIO
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=change-in-production-min-8-chars

# -----------------------------------------------------------------------------
# Keycloak
# Admin console: http://localhost:8080/admin
# -----------------------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-in-production

# Client secret for auth-hub-service (must match realm-export.json)
KEYCLOAK_AUTH_HUB_SECRET=auth-hub-dev-secret-change-in-prod

# -----------------------------------------------------------------------------
# Kong (no secrets needed in DB-less mode)
# Proxy:      http://localhost:8000
# Admin API:  http://localhost:8001
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Application service ports (used by compose.yml --profile services)
# -----------------------------------------------------------------------------
AUTH_HUB_PORT=3000
AUTH_HUB_GRPC_PORT=50051
USER_HUB_PORT=3001
KNOW_HUB_PORT=3002
