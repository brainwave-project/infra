# =============================================================================
# Dev environment — committed to repo (all values are throwaway dev credentials)
# Copy to env/.env.dev.local to override without touching this file.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=brainwave
POSTGRES_PASSWORD=brainwave_dev_pass
POSTGRES_DB=brainwave

# App-level DB roles (created by 01-schemas.sql — NOT the root Postgres user)
USERHUB_DB_PASS=userhub_dev_password
KNOWHUB_DB_PASS=knowhub_dev_password
AUDITHUB_DB_PASS=audithub_dev_password

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
MONGO_USER=brainwave
MONGO_PASSWORD=brainwave_dev_pass
MONGO_DB=brainwave_docs

# -----------------------------------------------------------------------------
# MinIO
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=minio_dev_pass_8chars

# -----------------------------------------------------------------------------
# Keycloak
# Admin console: http://localhost:8080/admin
# Token endpoint: http://localhost:8080/realms/brainwave/protocol/openid-connect/token
# -----------------------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_pass

# Must match the secret in keycloak/realm-export.json for auth-hub-service client
KEYCLOAK_AUTH_HUB_SECRET=auth-hub-dev-secret-change-in-prod

# -----------------------------------------------------------------------------
# Kong
# Proxy:      http://localhost:8000
# Admin API:  http://localhost:8001  (dev only)
# -----------------------------------------------------------------------------
# No secrets needed in DB-less mode

# -----------------------------------------------------------------------------
# Kafka
# Internal broker address used by all services inside the Docker network
# -----------------------------------------------------------------------------
KAFKA_BROKERS=kafka:9092

# -----------------------------------------------------------------------------
# Ollama models (pulled once by ollama-init into the brainwave-ollama-data volume)
#   OLLAMA_MODEL       — Phase 1 embeddings (nomic-embed-text, 768-dim)
#   OLLAMA_CHAT_MODEL  — Phase 2 generation (local instruction-tuned chat model)
# -----------------------------------------------------------------------------
OLLAMA_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.1:8b-instruct-q4_K_M

# -----------------------------------------------------------------------------
# Langfuse (self-hosted LLM observability — Phase 2)
# UI: http://localhost:3060   (all values are throwaway dev secrets)
# -----------------------------------------------------------------------------
LANGFUSE_DB_PASSWORD=langfuse_dev_pass
LANGFUSE_NEXTAUTH_SECRET=langfuse-dev-nextauth-secret-change-me
LANGFUSE_SALT=langfuse-dev-salt-change-me

# -----------------------------------------------------------------------------
# Application service ports
# -----------------------------------------------------------------------------
AUTH_HUB_PORT=3000
AUTH_HUB_GRPC_PORT=50051
USER_HUB_PORT=3001
KNOW_HUB_PORT=3002
AUDIT_HUB_PORT=3003
