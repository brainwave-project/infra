# =============================================================================
# Production environment template
# Copy to env/.env.prod and fill in real values.
# env/.env.prod is gitignored — NEVER commit it under any circumstances.
#
# For a real production deployment, prefer injecting secrets via:
#   - Docker Swarm secrets      (docker secret create)
#   - AWS SSM Parameter Store   (aws ssm get-parameter)
#   - HashiCorp Vault           (vault kv get)
# This .env approach is acceptable for a single-node VPS deployment.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# Use a strong randomly generated password (openssl rand -hex 32)
# -----------------------------------------------------------------------------
POSTGRES_USER=brainwave
POSTGRES_PASSWORD=CHANGE_ME_GENERATED_SECRET
POSTGRES_DB=brainwave

USERHUB_DB_PASS=CHANGE_ME_GENERATED_SECRET
KNOWHUB_DB_PASS=CHANGE_ME_GENERATED_SECRET

# -----------------------------------------------------------------------------
# MongoDB
# -----------------------------------------------------------------------------
MONGO_USER=brainwave
MONGO_PASSWORD=CHANGE_ME_GENERATED_SECRET
MONGO_DB=brainwave_docs

# -----------------------------------------------------------------------------
# MinIO
# Min 8 chars — must not contain spaces
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_GENERATED_SECRET

# -----------------------------------------------------------------------------
# Keycloak
# Admin password: treat as a root credential, store in password manager
# -----------------------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_GENERATED_SECRET
KEYCLOAK_AUTH_HUB_SECRET=CHANGE_ME_GENERATED_SECRET

# Keycloak public hostname — MUST match the `iss` claim in JWTs
# Also must match the `key` field in kong/kong.yml JWT credential
KC_HOSTNAME=auth.yourdomain.com

# -----------------------------------------------------------------------------
# Kong / Application
# -----------------------------------------------------------------------------
PUBLIC_DOMAIN=api.yourdomain.com

# -----------------------------------------------------------------------------
# Container registry
# Use a specific immutable tag (semver) — never `latest` in prod
# -----------------------------------------------------------------------------
REGISTRY=ghcr.io
IMAGE_ORG=your-github-org
IMAGE_TAG=1.0.0        # Pin to exact semver. Use digest for true immutability:
                       # IMAGE_TAG=sha256@abc123... (update compose.prod.yml accordingly)

# -----------------------------------------------------------------------------
# Application service ports
# All ports bind to 127.0.0.1 in prod — TLS termination happens at nginx/ALB
# -----------------------------------------------------------------------------
AUTH_HUB_PORT=3000
AUTH_HUB_GRPC_PORT=50051
USER_HUB_PORT=3001
KNOW_HUB_PORT=3002
