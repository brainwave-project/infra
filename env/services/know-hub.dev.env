# =============================================================================
# know-hub — dev container env
# Loaded via env_file in docker/compose.dev.yml
# =============================================================================

NODE_ENV=development
SERVICE_NAME=know-hub
LOG_LEVEL=debug

# OpenTelemetry — traces shipped to OTel Collector via HTTP
OTEL_SERVICE_NAME=know-hub
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# auth-hub gRPC client (host + port split per env contract)
AUTH_HUB_GRPC_HOST=auth-hub
AUTH_HUB_GRPC_PORT=50051

# MinIO (creds passed via compose environment:)
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_USE_SSL=false

# Semantic Layer (Phase 1) — local embeddings via Ollama. No external API key.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=nomic-embed-text
OLLAMA_BATCH_SIZE=8
OLLAMA_TIMEOUT_MS=30000
SEMANTIC_WORKER_ENABLED=true
SIMILARITY_THRESHOLD=0.60
QUERY_CACHE_SIZE=500
QUERY_CACHE_TTL_MS=300000
