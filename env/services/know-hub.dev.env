# =============================================================================
# know-hub — dev container env
# Loaded via env_file in docker/compose.dev.yml
# =============================================================================

NODE_ENV=development
SERVICE_NAME=know-hub
LOG_LEVEL=debug

# OpenTelemetry — traces shipped to OTel Collector via HTTP
OTEL_SERVICE_NAME=know-hub
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# auth-hub gRPC client (host + port split per env contract)
AUTH_HUB_GRPC_HOST=auth-hub
AUTH_HUB_GRPC_PORT=50051

# MinIO (creds passed via compose environment:)
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_USE_SSL=false

# Semantic Layer (Phase 1) — local embeddings via Ollama. No external API key.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=nomic-embed-text
OLLAMA_BATCH_SIZE=8
OLLAMA_TIMEOUT_MS=30000
SEMANTIC_WORKER_ENABLED=true
SIMILARITY_THRESHOLD=0.60
QUERY_CACHE_SIZE=500
QUERY_CACHE_TTL_MS=300000

# Conversational RAG (Phase 2) — local chat generation via Ollama. No API key.
CHAT_ENABLED=true
OLLAMA_CHAT_MODEL=llama3.1:8b-instruct-q4_K_M
CHAT_TEMPERATURE=0.2
CHAT_NUM_CTX=8192
CHAT_NUM_PREDICT=1024
# Must comfortably exceed a cold model load (~55s) so the first/idle turn never
# aborts before the first token. Aligned with Kong's /api/chat read_timeout.
CHAT_TIMEOUT_MS=300000
RAG_TOP_K=6
RAG_MAX_CONTEXT_TOKENS=5900
CHAT_HISTORY_TURNS=6

# LLM observability — self-hosted Langfuse (best-effort; never blocks chat).
# Keys come from the Langfuse project (create one at http://localhost:3060).
LANGFUSE_ENABLED=true
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=pk-lf-c39ccc1d-6d17-439a-9769-bdfb0ca19bcc
LANGFUSE_SECRET_KEY=sk-lf-b160cc14-ae1d-4258-8ea1-831b0f823ba0
