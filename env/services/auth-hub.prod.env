# =============================================================================
# auth-hub — prod container env
# Loaded via env_file in docker/compose.prod.yml
# Contains only literal values that don't change between deployments of prod.
# Interpolated values (DB creds, public domain) live in compose environment:.
# =============================================================================

NODE_ENV=production
SERVICE_NAME=auth-hub
LOG_LEVEL=info

# Postgres host (docker network)
DB_HOST=postgres

# Keycloak (prod: same docker network, public domain handled at gateway)
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_REALM=brainwave
KEYCLOAK_CLIENT_ID=auth-hub-service
