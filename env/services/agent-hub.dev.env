# =============================================================================
# agent-hub — dev container env  (Phase 3: Agentic RAG & multi-agent ingestion)
# Loaded via env_file in docker/compose.dev.yml. Literals only — no interpolation
# (secrets / ${...} values are injected via compose `environment:`).
# =============================================================================

ENV=development
SERVICE_NAME=agent-hub
LOG_LEVEL=debug
PORT=3004

# --- Reasoning + embedding model host (local Ollama, air-gapped) ---
OLLAMA_BASE_URL=http://ollama:11434
# Tool-calling model reused from Phase 2 chat (real pulled tag from ollama-init).
AGENT_REASONING_MODEL=llama3.1:8b-instruct-q4_K_M

# --- know-hub (system of record) ---
# CRAG retrieval reuses the EXISTING HTTP /api/semantic path (gRPC deferred to
# M6 — review Issue 2). KNOW_HUB_GRPC_PORT is reserved for the M6 write path.
KNOW_HUB_URL=http://know-hub:3002
KNOW_HUB_GRPC_PORT=50052

# --- Kafka (ingestion crew trigger, wired M6) ---
KAFKA_BROKERS=kafka:9092

# --- CRAG guardrails + retrieval defaults ---
# Shipped defaults. The Governance store (agent.agent_governance) overlays
# operator overrides set from the UI, so these are the reset baseline.
CRAG_MAX_LOOPS=2
CRAG_MAX_REGEN=1
CRAG_TOP_K=6
CRAG_MIN_SCORE=0.0
CRAG_QUERY_REWRITE_ENABLED=true
CRAG_GROUNDING_ENABLED=true

# Per-node temperatures (0 = deterministic judgement; generation runs warmer).
CRAG_GRADE_TEMPERATURE=0.0
CRAG_REWRITE_TEMPERATURE=0.0
CRAG_GENERATE_TEMPERATURE=0.2
CRAG_GROUNDING_TEMPERATURE=0.0

# --- Cross-Encoder reranker (stage-2 retrieval) ---
# OFF by default; enabling it requires the optional `rerank` extra
# (uv sync --extra rerank). Fail-open if the model/lib is unavailable.
CROSS_ENCODER_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_K=20
RERANK_TOP_N=4

# --- Prompt management (Langfuse) ---
PROMPT_LABEL=production

# --- LLM observability — self-hosted Langfuse (wired M4; off until then) ---
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
