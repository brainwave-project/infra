# =============================================================================
# audit-hub — dev container env
# Loaded via env_file in docker/compose.dev.yml
# =============================================================================

NODE_ENV=development
SERVICE_NAME=audit-hub
LOG_LEVEL=debug

# OpenTelemetry — traces shipped to OTel Collector via HTTP
OTEL_SERVICE_NAME=audit-hub
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Kafka consumer group (must be stable for offset persistence)
KAFKA_GROUP_ID=brainwave.audit-hub
