# =============================================================================
# user-hub — dev container env
# Loaded via env_file in docker/compose.dev.yml
# =============================================================================

NODE_ENV=development
SERVICE_NAME=user-hub
LOG_LEVEL=debug

# auth-hub gRPC client (host + port split per user-hub env contract)
AUTH_HUB_GRPC_HOST=auth-hub
AUTH_HUB_GRPC_PORT=50051

# Keycloak (admin creds passed via compose environment:)
KEYCLOAK_BASE_URL=http://keycloak:8080
