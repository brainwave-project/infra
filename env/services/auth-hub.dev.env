# =============================================================================
# auth-hub — dev container env
# Loaded via env_file in docker/compose.dev.yml
# Contains only literal values that don't change between deployments of dev.
# Interpolated values (DB creds, ports) live in compose environment: blocks.
# =============================================================================

NODE_ENV=development
SERVICE_NAME=auth-hub
LOG_LEVEL=debug

# Postgres host (docker network — see compose env: for credentials)
DB_HOST=postgres

# Keycloak (dev: local container)
KEYCLOAK_BASE_URL=http://keycloak:8080
KEYCLOAK_REALM=brainwave
KEYCLOAK_CLIENT_ID=auth-hub-service
KEYCLOAK_REDIRECT_BASE_URL=http://localhost:8000
